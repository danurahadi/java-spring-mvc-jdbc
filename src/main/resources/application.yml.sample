spring:
  application:
    name: starter-api
  threads:
    virtual:
      enabled: true
  datasource:
    url: jdbc:mysql://localhost:<port>/<db_name>
    username: <user_name>
    password: <user_pass>
    hikari:
      pool-name: starter-api
      maximum-pool-size: 10
      minimum-idle: 10
      connection-timeout: 3000
      validation-timeout: 1000
      idle-timeout: 600000
      max-lifetime: 1800000
      keepalive-time: 60000
  flyway:
    enabled: true
    locations: classpath:db/migration
  lifecycle:
    timeout-per-shutdown-phase: 30s
  mvc:
    problemdetails:
      enabled: true
  web:
    error:
      include-message: never
      include-stacktrace: never

server:
  port: 7000
  shutdown: graceful
  forward-headers-strategy: none

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      probes:
        enabled: true
      show-details: never

app:
  auth0:
    issuer-uri: "https://jogjacode.jp.auth0.com/"
    jwk-set-uri: "https://jogjacode.jp.auth0.com/.well-known/jwks.json"
    audience: "https://api.jogjanode.com"
  openapi:
    access: PUBLIC

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
